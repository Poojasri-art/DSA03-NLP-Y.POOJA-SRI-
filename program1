import re
text = "My email is pooja13@gmail.com and my phone number is 7675820805."
email = re.search(r'\S+@\S+', text)
phone = re.search(r'\d{10}', text)
print("Original Text:")
print(text)
print("\nEmail Found:")
print(email.group())
print("\nPhone Number Found:")
print(phone.group())



